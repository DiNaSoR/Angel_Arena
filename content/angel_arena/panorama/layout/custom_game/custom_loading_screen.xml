<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/custom_loading_screen.css" />
  </styles>
  <Panel class="ArenaLoadingScreen" hittest="false">
    <Image class="ArenaBackdrop" src="file://{images}/custom_game/loading_screen/arena_at_dusk.png" scaling="stretch-to-cover-preserve-aspect" />
    <Panel class="ArenaShade" />
    <Panel class="ArenaWelcome">
      <Label class="ArenaTitle" text="#addon_game_name" />
      <Panel class="ArenaDivider" />
      <Label class="ArenaPremise" text="#arena_loading_premise" />
      <Panel class="ArenaObjectives">
        <Label class="ArenaObjective" text="#arena_loading_kills" />
        <Label class="ArenaObjective ArenaBossObjective" text="#arena_loading_boss" />
      </Panel>
    </Panel>
  </Panel>
</root>
