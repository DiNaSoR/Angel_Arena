<!-- Runs with the in-game HUD. It has no visible panels of its own: the script reskins Dota's
     shop, and the images below are listed so they get compiled. -->
<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/arena_skin.js" />
    <include src="file://{resources}/scripts/custom_game/arena_shop.js" />
  </scripts>
  <Panel hittest="false" style="width: 100%; height: 100%;">
    <Panel style="visibility: collapse;" hittest="false">
      <Image src="file://{images}/custom_game/arena_ui/armory_strip.png" />
    </Panel>
  </Panel>
</root>
