# Cache crap that Valve autogenerates
*.bin

# Ignore map overviews
content/dota_addons/angel_arena/materials/overviews/*
game/dota_addons/angel_arena/materials/overviews/*
game/dota_addons/angel_arena/resource/overviews/*


# Ignore all compiled resources
*.vpcf_c
*.vtex_c
*.vmat_c
*.vsndevts_c

# Map Files
*.vpk

# Workshop Tools compiles Panorama from content sources.
/game/angel_arena/panorama/**/*.vcss_c
/game/angel_arena/panorama/**/*.vjs_c
/game/angel_arena/panorama/**/*.vxml_c
